{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Fixes"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Chores",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "agent-evals",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/cli/src/product.json",
          "jsonpath": "$.version"
        }
      ],
      "release-as": "0.1.0"
    }
  }
}
