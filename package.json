{
  "name": "agent-evals-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "examples",
    "tooling"
  ],
  "scripts": {
    "cli": "bun run packages/cli/src/main.ts",
    "check": "bun run typecheck && bun run lint && bun run knip && bun run test",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "lint": "biome lint --error-on-warnings --diagnostic-level=warn . && bun run tooling/src/conventions.ts && bun run tooling/src/boundaries.ts && bun run tooling/src/prose.ts && bun run tooling/src/packageGuides.ts",
    "lint:fix": "biome lint --write .",
    "guides": "bun run tooling/src/packageGuides.ts --write",
    "knip": "knip",
    "build": "turbo run build",
    "stage": "turbo run stage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
